# Google Gemini API Key（商品説明生成 + Vision画像解析フォールバック）
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key（Vision優先: gpt-4o。未設定時は Gemini を使用）
OPENAI_API_KEY=

# Sentry DSN（クライアント・サーバー共通）
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx.ingest.sentry.io/xxxxxxxx

# GA4 Measurement Protocol（サーバー送信）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GA4_API_SECRET=xxxxxxxx

# Supabase（app_logs など）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# Discord Webhook URL（お問い合わせ通知用）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# お問い合わせ返信用の事業用 Gmail（表示用ラベル）
SUPPORT_GMAIL_ACCOUNT=nomadlabsupport@gmail.com
# ブラウザにログイン中のアカウント番号（0=個人、1=事業用など）
SUPPORT_GMAIL_ACCOUNT_INDEX=1

# Stripe（Checkout / Customer Portal）
# Price は税込・JPY。プレミアム月額 500円 / Pro 月額 980円 / チケット 300円 の Price ID を設定
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PRICE_ID_SOLD_PRO=price_xxxxxxxx
STRIPE_PRICE_ID_SOLD_PREMIUM=price_xxxxxxxx
STRIPE_PRICE_ID_TICKET_10=price_xxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxx
SESSION_SECRET=replace-with-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

