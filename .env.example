# Copy this file to `.env.local` and fill in real values.

# Google Gemini API Key（商品説明生成 + Vision画像解析フォールバック）
GEMINI_API_KEY=

# OpenAI API Key（Vision優先: gpt-4o。未設定時は Gemini を使用）
OPENAI_API_KEY=

# Sentry DSN（クライアント・サーバー共通）
NEXT_PUBLIC_SENTRY_DSN=

# GA4 Measurement Protocol（サーバー送信）
NEXT_PUBLIC_GA_ID=
GA4_API_SECRET=

# Supabase（app_logs / Auth など）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend（お問い合わせ・Auth 確認メール等。From は常に フリマリストSold <noreply@cloudflowriver.com>）
RESEND_API_KEY=
# Supabase Auth → Hooks → Send Email のシークレット（例: v1,whsec_xxx）
SEND_EMAIL_HOOK_SECRET=

# Discord Webhook URL（お問い合わせ通知用）
DISCORD_WEBHOOK_URL=

# お問い合わせ返信用の事業用 Gmail（表示用ラベル）
SUPPORT_GMAIL_ACCOUNT=nomadlabsupport@gmail.com
# ブラウザにログイン中のアカウント番号（0=個人、1=事業用など）
SUPPORT_GMAIL_ACCOUNT_INDEX=1

# Stripe（Checkout / Customer Portal）
# Sold Pro 月額500円。既存の500円用 Price ID は STRIPE_PRICE_ID_SOLD_PREMIUM を優先使用
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_SOLD_PREMIUM=
STRIPE_PRICE_ID_SOLD_PRO=
STRIPE_PRICE_ID_PRO=
SESSION_SECRET=
# サイト公開URL（Auth メールリンクの redirectTo にも使用）
# 本番例: https://fleama-maker.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ALLOW_DEV_BYPASS_PRO="true" # ローカル開発用：PRO権限バイパス
