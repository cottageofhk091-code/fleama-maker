# Copy this file to `.env.local` and fill in real values.

# Google Gemini API Key（商品説明生成 + Vision画像解析フォールバック）
GEMINI_API_KEY=

# OpenAI API Key（Vision優先: gpt-4o。未設定時は Gemini を使用）
OPENAI_API_KEY=

# Sentry DSN（クライアント・サーバー共通）
NEXT_PUBLIC_SENTRY_DSN=

# Discord Webhook URL（お問い合わせ通知用）
DISCORD_WEBHOOK_URL=

# Stripe（Checkout / Customer Portal）
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_SOLD_PRO=
STRIPE_PRICE_ID_SOLD_PREMIUM=
STRIPE_PRICE_ID_TICKET_10=
# 後方互換（未設定時は SOLD_PRO のフォールバック）
STRIPE_PRICE_ID_PRO=
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
